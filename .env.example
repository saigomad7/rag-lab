# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 공유 · 커밋하지 않는다.
# Windows: 명령 프롬프트에서  copy .env.example .env  / 메모장으로 열어 수정 (UTF-8 저장)
# 경로는 D:\models\bge-m3 또는 D:/models/bge-m3 둘 다 된다. 따옴표는 붙이지 않는다.
# sample = DB 없이 샘플 데이터로 실행 / live = 사내 Oracle · Milvus · 모델 사용
LAB_MODE=sample

# Oracle
ORA_USER=
ORA_PASSWORD=
ORA_DSN=host:1521/SERVICE_NAME
# thick 모드가 필요할 때만 (Oracle Instant Client 폴더) 예: C:\oracle\instantclient_19_20
ORA_THICK_LIB=

# Milvus
MILVUS_URI=http://milvus-host:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_chunks

# 임베딩: local(FlagEmbedding 설치 + 모델 폴더) | api(OpenAI 호환 /v1/embeddings) | sample
EMBED_MODE=sample        # sample(기본) | api(OpenAI 호환 · 설치 불필요) | local(FlagEmbedding 설치 필요)
BGE_M3_PATH=D:\models\bge-m3
EMBED_URL=
EMBED_MODEL=bge-m3       # 사내 BGE-M3 기준. OpenAI=text-embedding-3-small · 구글=text-embedding-004
# 현재 운영 중인 max_length 값을 그대로 (잘림 점검 S04-1)
EMBED_MAX_LENGTH=512

# 리랭커: local | api | none | sample
RERANK_MODE=sample       # sample(기본) | api | local | none
RERANK_PATH=D:\models\bge-reranker-v2-m3
RERANK_URL=

# 사내 LLM (OpenAI 호환)
LLM_URL=http://llm-host:8000/v1/chat/completions
LLM_MODEL=
LLM_API_KEY=none

# 기존 사내 검색 API (지금 시스템 그대로 스모크 · 평가할 때). 없으면 비워 둔다
SEARCH_API_URL=
SEARCH_API_TOKEN=

HTTP_TIMEOUT=60
VERIFY_SSL=false

# ============================================================
# [개인 노트북 학습용] 샘플 데이터 + 실제 모델
#   사내 DB · Milvus 없이 샘플 문서 16건으로 연습하되, 임베딩 · LLM 은 진짜로 호출한다.
#   → 답변 · 골든셋 생성이 실제로 돌아가므로 지표 숫자가 의미를 가진다.
#   사내 데이터는 들어가지 않으므로 외부 API 사용 가능. 사내 PC 에서는 이 블록을 쓰지 않는다.
# ------------------------------------------------------------
# LAB_MODE=sample
# SAMPLE_MODELS=true
# SAMPLE_SET=100                 # 샘플 문서 100건 (기본 16) — 지표 비교가 의미를 갖는 규모
# EMBED_MODE=api
# EMBED_URL=https://api.openai.com/v1/embeddings
# EMBED_MODEL=text-embedding-3-small
# RERANK_MODE=sample
# LLM_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# VERIFY_SSL=true
#
# --- 구글 Gemini (OpenAI 호환 엔드포인트) 로 쓸 때 ---
# LAB_MODE=sample
# SAMPLE_MODELS=true
# SAMPLE_SET=100
# EMBED_MODE=api
# EMBED_URL=https://generativelanguage.googleapis.com/v1beta/openai/embeddings
# EMBED_MODEL=gemini-embedding-001        # 목록 확인:  lab_search.list_models()
# EMBED_RPM=5                             # 분당 요청 수 제한 (무료 키는 5 권장 · 0=제한 없음)
# EMBED_BATCH=8                           # 한 요청에 보낼 문장 수
# EMBED_CACHE=true                        # 같은 문장은 재호출 안 함 (out/_embed_cache 에 저장)
# RERANK_MODE=sample                      # 구글 · OpenAI 모두 리랭커 API 없음 → sample 로
# LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_MODEL=gemini-2.0-flash
# LLM_RPM=10                              # 분당 호출 수 (무료 키 권장) · LLM_RETRY=5 로 재시도 횟수 조정
# LLM_API_KEY=<구글 AI Studio 키>
# VERIFY_SSL=true
#   주소는 끝까지 적지 않아도 자동으로 /embeddings · /chat/completions 를 붙인다.
#   임베딩 키를 따로 쓰려면 EMBED_API_KEY 를 지정 (없으면 LLM_API_KEY 사용)
